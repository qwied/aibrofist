# Copy this file to .env and fill in real values. .env is git-ignored —
# never commit your real token.

# Bot token from the Discord Developer Portal (Bot tab -> Reset Token).
DISCORD_BOT_TOKEN=

# Right-click the channel in Discord (Developer Mode must be on) -> Copy Channel ID.
# The bot posts new site updates here. Defaults to the #updates channel
# (1543927183385428028) if left empty — set this only to point the bot at
# a different channel. Set to 0 to disable auto-posting.
NEWS_CHANNEL_ID=1543927183385428028

# Base URL of the game site. Only change this for local testing against a
# dev server.
API_BASE=https://aibrofist.online

# How often to check for new updates, in seconds.
POLL_INTERVAL_SECONDS=60

# Where to remember which updates have already been posted, so a restart
# doesn't repost the whole news archive.
SEEN_LOG_FILE=seen_logs.json
